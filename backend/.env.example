# Copy to backend/.env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# REQUIRED in production: any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Postgres connection string (Neon, Supabase, …). Unset → embedded local database in backend/.data/
DATABASE_URL=

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (button hidden when unset)
GOOGLE_CLIENT_ID=

# Mobile OTP via Twilio. Unset → outside production the code is shown on screen; in production mobile login is hidden
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated emails that can triage disaster reports at /admin/reports
ADMIN_EMAILS=

# Extra origins allowed to call the API with cookies (not needed when frontend and API share a domain)
CORS_ORIGINS=
